#!/usr/bin/env bash
# One pass: mirror each agent pane's stripped terminal title onto its pane
# border label. Labels a human set by hand are left alone — the state file
# remembers every label this plugin wrote, and only those get overwritten.
set -euo pipefail

herdr=${HERDR_BIN_PATH:-herdr}
state_dir=${HERDR_PLUGIN_STATE_DIR:-/tmp/drip-pane-titles}
mkdir -p "$state_dir"
state="$state_dir/labels.json"
[[ -s $state ]] || echo '{}' > "$state"

"$herdr" pane list | jq -c '.result.panes[] | select(.agent != null)' |
while IFS= read -r pane; do
  id=$(jq -r .pane_id <<<"$pane")
  title=$(jq -r '.terminal_title_stripped // empty' <<<"$pane")
  label=$(jq -r '.label // empty' <<<"$pane")
  [[ -z $title || $title == "$label" ]] && continue
  ours=$(jq -r --arg id "$id" '.[$id] // empty' "$state")
  [[ -n $label && $label != "$ours" ]] && continue
  "$herdr" pane rename "$id" "$title" >/dev/null
  jq --arg id "$id" --arg t "$title" '.[$id] = $t' "$state" > "$state.tmp" \
    && mv "$state.tmp" "$state"
done
