#!/usr/bin/env bash
# Startup hook: keep the sidebar's accounts rail fed.
#
# All the work is `gumbo watch`'s: it owns the cache, the TTL and the backoff,
# so the rail redraws on its own cadence while Anthropic's usage endpoint is
# only actually read once every few minutes however often we look. This script
# decides where the file goes and keeps the watcher alive; it holds no
# credential and makes no request itself.
#
# The rail is a hardcore plugin (nix/herdr-patches.nix) that reads that one
# file. No file, no rail — so a box without gumbo needs nothing turned off.
#
# THAT SILENCE IS ONLY FOR THE BOX WITH NO GUMBO. Where gumbo IS installed
# somebody meant to have a rail, and a watcher that cannot produce one has to
# say so in the only channel the rail has: the file. Otherwise the failure
# looks exactly like success with nothing to show — which is how `dr-vsv2 —
# The gumbo accounts rail never shows in a kart: the sidebar patch renders a
# state file that nothing in a kart writes` stayed invisible on every kart
# ever booted. So this script never gives up, and while it is failing it keeps
# a one-row status in the file rather than leaving stale numbers or nothing.
set -uo pipefail

out=${HERDR_DRIP_ACCOUNTS_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-drip/sidebar-accounts.txt}
# ~21 columns is what the sidebar leaves at its default width (26) once the
# separator and the rail's own margin are taken. This is a CEILING, not a
# target: the compact layout is 19 columns wide and stays there, so a wider
# rail buys air on the right rather than a wider meter. It only matters below
# 19, where the meter gives up cells to keep the percent and the eta whole.
width=${HERDR_DRIP_ACCOUNTS_WIDTH:-21}
# How often the RAIL is redrawn, which is not how often Anthropic is read --
# that is gumbo's cache TTL (300s) and nothing here can shorten it. Five
# seconds because the `▸` marker moves on its own: gumbo spreads new sessions
# by assigned-key count, so opening one session changes where the next lands,
# and a marker that redraws twice a minute would be pointing at the previous
# answer most of the time. A tick costs one unix-socket call to the daemon and
# a read of its own cache; `gumbo watch`'s own comment calls 60 renders per
# read the intended shape.
interval=${HERDR_DRIP_ACCOUNTS_INTERVAL:-5}

if ! command -v gumbo >/dev/null 2>&1; then
  echo "gumbo is not on the herdr server's PATH; the accounts rail stays empty" >&2
  exit 0
fi

# Put a single row in the rail, in gumbo's own tagged format: `<grade><kind>
# <text>`, graded `-` so the sidebar paints it as "nothing could be read"
# rather than as a claim about somebody's headroom. Written through a temp and
# renamed, the same way gumbo writes its frames, so a reader never sees half a
# file. Best-effort throughout: a rail that cannot say it is broken must not
# take the watcher down with it.
rail_status() {
  local text=$1 dir tmp
  dir=$(dirname -- "$out")
  mkdir -p -- "$dir" 2>/dev/null || return 0
  tmp=$dir/.$(basename -- "$out").status.$$
  printf -- '-a  ⚠ %s\n' "$text" > "$tmp" 2>/dev/null || { rm -f -- "$tmp"; return 0; }
  mv -f -- "$tmp" "$out" 2>/dev/null || rm -f -- "$tmp"
  return 0
}

# A watcher that exits immediately is telling us something — no store on this
# box, an unreadable config, a daemon that is not up. In a kart at boot the
# last of those is NORMAL and temporary: `kart-gumbo-config` materialises the
# endpoint while everything else is starting, so the first few attempts can
# lose that race. This used to give up after five of them, permanently, which
# turned a thirty-second startup order problem into a rail that was dead until
# somebody restarted herdr.
#
# So: retry forever, backing off 30s → 5m so a genuinely broken box costs one
# log line every five minutes rather than a flood. The ceiling is under the
# rail's staleness window (10m), which is what keeps the status row below fresh
# enough to be drawn — a slower backoff would let the rail fall silent again
# between attempts.
#
# A watcher that ran for a while and then died (a daemon restart, a transient
# store error) is a different animal: the rail had real data until it stopped,
# so the count resets, the backoff resets, and the last frame is left alone to
# go stale on its own if the restart does not take.
min_backoff=30
max_backoff=300
failures=0
backoff=$min_backoff
while :; do
  started=$SECONDS
  gumbo watch --format compact --tags --width "$width" --interval "$interval" --out "$out"
  status=$?
  ran=$((SECONDS - started))
  if ((ran >= 5)); then
    echo "gumbo watch exited (status $status) after ${ran}s; restarting" >&2
    failures=0
    backoff=$min_backoff
  else
    ((failures++))
    # Only on the way in and on each backoff step, not once per attempt.
    if ((failures == 1 || backoff == max_backoff)); then
      echo "gumbo watch exited immediately (status $status), $failures time(s); retrying in ${backoff}s" >&2
    fi
    rail_status "feed down"
  fi
  sleep "$backoff"
  if ((backoff < max_backoff)); then
    backoff=$((backoff * 2))
    ((backoff > max_backoff)) && backoff=$max_backoff
  fi
done
