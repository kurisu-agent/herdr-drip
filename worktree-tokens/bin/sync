#!/usr/bin/env bash
# One pass: report each agent pane's git worktree name (basename of the
# repo/worktree toplevel; plain cwd basename outside git) as a `worktree`
# token, for `$worktree` rows in [ui.sidebar.agents]. TTL'd so tokens for
# closed panes fade out on their own.
set -euo pipefail

herdr=${HERDR_BIN_PATH:-herdr}
seq=$(date +%s)

"$herdr" pane list | jq -c '.result.panes[] | select(.agent != null)' |
while IFS= read -r pane; do
  id=$(jq -r .pane_id <<<"$pane")
  cwd=$(jq -r '.foreground_cwd // .cwd // empty' <<<"$pane")
  [[ -z $cwd || ! -d $cwd ]] && continue
  top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || top=$cwd
  "$herdr" pane report-metadata "$id" --source drip.worktree-tokens \
    --token "worktree=$(basename "$top")" --seq "$seq" --ttl-ms 30000 \
    >/dev/null
done
