#!/usr/bin/env bash
# Toggle the board docked on the LEFT edge of this tab.
#
# The same split of labour bin/sync has with bin/board.js: this decides that
# bun is there and where the plugin root is, bin/open.js does the work. Both
# launchers are one file because the only difference between them is a word.
set -uo pipefail

root=${HERDR_PLUGIN_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}

if ! command -v bun >/dev/null 2>&1; then
  echo "bun is not on the herdr server's PATH; cannot open the beads dock" >&2
  exit 0
fi

exec bun "$root/bin/open.js" dock
