#!/usr/bin/env zsh
# herdr's default_shell: an interactive pane starts claude in yolo mode, and
# exiting claude lands in a normal shell instead of closing the pane. A pane
# herdr spawned as a plain terminal (HERDR_DRIP_PANE_KIND=shell, set by the
# drip's herdr patches for new workspaces, new tabs and the pane menu's
# `(shell)` splits) skips the agent entirely. A session restore puts each pane
# back the way it was -- agent panes resumed, shell panes still shells.
#
# "yolo mode" is whatever $YOLO_SHELL_LAUNCHER names; with it unset, the `yolo`
# COMMAND when one is on PATH (e.g. a gumbo multi-account gateway launcher that
# routes claude through a local account pool and stamps a per-launch session id
# the statusline reads); otherwise plain `claude --dangerously-skip-permissions`.
# We call the command rather than the `yolo` shell alias/function so it resolves
# HERE, in a non-interactive script.
#
# Set YOLO_SHELL_LAUNCHER in the herdr SERVER's environment (that is what panes
# inherit) to name the launcher explicitly -- a wrapper under a different name,
# an absolute path, or `claude --dangerously-skip-permissions` to opt a host out
# of a `yolo` that happens to be on its PATH. It is a command line, not a path:
# extra words are passed through as leading arguments, and it is split the way
# the shell would split it -- (z) parses it into words honouring quotes, (Q)
# then strips those quotes -- so an argument that contains a space survives if
# it is quoted. No eval: the words become argv directly.
if [[ -n ${YOLO_SHELL_LAUNCHER:-} ]]; then
  launcher=( ${(Q)${(z)YOLO_SHELL_LAUNCHER}} )
elif command -v yolo >/dev/null 2>&1; then
  launcher=( yolo )
else
  launcher=( claude --dangerously-skip-permissions )
fi

launch() {
  "${launcher[@]}" "$@"
}

# Remember what this pane is running, so the next session restore can put back
# what was there. herdr respawns EVERY pane with default_shell and only injects
# a resume line for the ones that had an agent session, so a pane the user had
# dropped to a shell used to come back as a fresh claude -- the restore quietly
# overwrote it. Nothing in herdr's persisted state distinguishes that pane from
# a brand new one (it clears agent_session when the agent exits, and the label
# keeps claude's stale terminal title), so we keep the fact ourselves.
#
# HERDR_PANE_ID is the key: herdr persists each workspace's public pane numbers
# and hands the same ones back after a restore, and the counter is monotonic --
# a closed pane's number is never reused -- so a record can never be read by a
# different pane than the one that wrote it. Named sessions have separate id
# spaces, hence the per-session directory. Every path below rewrites the file
# within milliseconds of the pane starting, so a restore refreshes every live
# pane and only records for panes that are long gone go stale; those are pruned
# by age.
#
# zsh/files gives us mkdir and rm as builtins, so the bookkeeping does not care
# what is on the herdr server's PATH -- the same reason the rest of the drip is
# careful about it.
zmodload -F zsh/files b:zf_mkdir b:zf_rm 2>/dev/null
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/herdr-drip/panes/${HERDR_SESSION:-default}
state_file=
if [[ -n ${HERDR_PANE_ID:-} ]] && zf_mkdir -p $state_dir 2>/dev/null; then
  state_file=$state_dir/${HERDR_PANE_ID//[^A-Za-z0-9_:.-]/_}
  for stale in $state_dir/*(N.m+30); do zf_rm -f -- $stale; done
fi

was=
[[ -n $state_file && -r $state_file ]] && was=$(<$state_file)

mark() {
  [[ -n $state_file ]] && print -r -- $1 >| $state_file 2>/dev/null
  return 0
}

# What kind of pane herdr says this is. The drip's herdr patches set `shell`
# in the launch env for every new workspace, every new tab, every worktree it
# opens, and the pane menu's two `Shell` splits -- the gestures that mean
# "somewhere to work", as opposed to a split, which is how you ask for another
# agent. The pane menu's `New Agent` sets `agent`, for the opposite reason:
# that gesture creates a workspace, and a workspace is what the shell default
# above is attached to, so it has to say so to get an agent. Deciding here
# rather than in the patch is the point: herdr sets one variable and knows
# nothing about what a shell is, so the same patched herdr on a host with an
# ordinary default_shell inherits one unused variable and behaves as stock.
#
# Only `shell` is tested, so any other value -- `agent`, or one a future patch
# invents -- takes the agent path below, which is also what NO value does.
#
# Read BEFORE the stdin peek below, not folded into its condition: the peek
# spends 0.5s waiting for a resume line that cannot arrive here, since herdr
# only injects one for a pane that had an agent session and this pane was born
# a moment ago. That wait would land on every new workspace.
#
# It is a spawn-time flag with no life after this: herdr persists no launch
# env, so a restored pane arrives without it. `mark shell` is what carries the
# fact across a server restart -- the same record that remembers a pane you
# dropped out of claude by hand. Unset unconditionally, whichever kind it named,
# so the pane's own environment does not hand a herdr-internal marker to
# everything the user runs in it.
kind=${HERDR_DRIP_PANE_KIND:-}
unset HERDR_DRIP_PANE_KIND
if [[ $kind == shell ]]; then
  mark shell
  exec zsh -i
fi

# On session restore herdr assumes default_shell is a plain shell and injects
# the pane's agent command (`claude --resume <id>`) as terminal input right
# after spawning us. Peek stdin before launching so that line becomes a yolo
# resume instead of landing verbatim in the fresh claude's chat box. The
# injected bytes are written before the shell even starts, so they are already
# buffered; the timeout is only slack for normal panes, where nothing arrives.
#
# Match on the command's BASENAME, not the literal word `claude`: herdr injects
# whatever path it launched the agent with, and since 0.8.0 that is an absolute
# one (`/home/you/.claude/cc/current/claude --resume <id>`). Patterns anchored
# on the bare word missed it, so every injected pane fell through to the
# eval-verbatim arm below and ran claude DIRECTLY -- silently unrouted, which
# on a gumbo host means no account pool and no session id. Anything that is not
# a claude keeps running verbatim: herdr may inject a real command, and second-
# guessing it is not our business.
line=
IFS= read -r -t 0.5 line || true
first=${line%% *}
if [[ -z $line && $was == shell ]]; then
  # A restored pane that was a plain shell when the server went down. herdr has
  # nothing to inject for it, so we are the only thing that would start claude
  # here -- don't, and let it come back the shell it was.
  :
else
  case ${first:t} in
    ''|claude) mark agent; eval "launch ${line#"$first"}" ;;
    *)         mark shell; eval "$line" ;;
  esac
fi
mark shell
exec zsh -i
